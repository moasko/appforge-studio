{
  "name": "appforge-studio",
  "productName": "AppForge Studio",
  "version": "0.1.0",
  "description": "Agent IA de bureau pour créer, tester, héberger et déployer des apps mobiles Expo + backend, avec n'importe quel modèle (Claude, OpenAI, LM Studio, Ollama...).",
  "main": "./out/main/index.js",
  "author": "AppForge",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "npx --yes tsx@4 --tsconfig tsconfig.node.json --require ./tests/mock-electron.cjs tests/agent.e2e.ts",
    "icon": "node scripts/generate-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.75.0",
    "openai": "^7.59.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.30.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moasko/appforge-studio.git"
  },
  "homepage": "https://github.com/moasko/appforge-studio#readme",
  "bugs": {
    "url": "https://github.com/moasko/appforge-studio/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "expo",
    "react-native",
    "electron",
    "claude",
    "ollama",
    "lm-studio",
    "code-generator"
  ]
}
